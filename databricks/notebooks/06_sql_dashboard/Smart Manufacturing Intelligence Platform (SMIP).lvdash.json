{
  "datasets": [
    {
      "name": "07abbdcd",
      "displayName": "Factory Performance Insights",
      "queryLines": [
        "SELECT *\r\n",
        "FROM smip_v2.manufacturing.factory_dashboard;"
      ]
    },
    {
      "name": "c19a44f8",
      "displayName": "Manufacturing Product Performance Overview",
      "queryLines": [
        "SELECT\r\n",
        "    product_name,\r\n",
        "    products_started\r\n",
        "FROM smip_v2.manufacturing.production_kpis\r\n",
        "ORDER BY products_started DESC;"
      ]
    },
    {
      "name": "a912262d",
      "displayName": "Shift Production Summary Report",
      "queryLines": [
        "SELECT\r\n",
        "    planned_shift,\r\n",
        "    SUM(products_started) AS products\r\n",
        "FROM smip_v2.manufacturing.production_kpis\r\n",
        "GROUP BY planned_shift;"
      ]
    },
    {
      "name": "05dda551",
      "displayName": "Machine Operations Performance Overview",
      "queryLines": [
        "SELECT\r\n",
        "    machine_name,\r\n",
        "    operations_completed\r\n",
        "FROM smip_v2.manufacturing.machine_kpis\r\n",
        "where machine_name is not null\r\n",
        "ORDER BY operations_completed DESC;"
      ]
    },
    {
      "name": "5024d024",
      "displayName": "Manufacturing Machine Performance Insights",
      "queryLines": [
        "SELECT\r\n",
        "    machine_name,\r\n",
        "    average_cycle_time_sec\r\n",
        "FROM smip_v2.manufacturing.machine_kpis;"
      ]
    },
    {
      "name": "2feba4ed",
      "displayName": "Machine Performance Overview",
      "queryLines": [
        "SELECT\r\n",
        "    machine_name,\r\n",
        "    pass_rate\r\n",
        "FROM smip_v2.manufacturing.machine_kpis;"
      ]
    },
    {
      "name": "2a612c08",
      "displayName": "Quality Control Insights for Product Testing",
      "queryLines": [
        "SELECT\r\n",
        "    product_name,\r\n",
        "    tests_completed\r\n",
        "FROM smip_v2.manufacturing.quality_kpis\r\n",
        "ORDER BY tests_completed DESC;"
      ]
    },
    {
      "name": "25227e6b",
      "displayName": "Quality Metrics Overview for Product Performance",
      "queryLines": [
        "SELECT\r\n",
        "    product_name,\r\n",
        "    pass_rate\r\n",
        "FROM smip_v2.manufacturing.quality_kpis;"
      ]
    },
    {
      "name": "076a78f4",
      "displayName": "Supplier Materials Scan Ranking Summary",
      "queryLines": [
        "SELECT\r\n",
        "    supplier,\r\n",
        "    materials_scanned\r\n",
        "FROM smip_v2.manufacturing.material_kpis\r\n",
        "ORDER BY materials_scanned DESC;"
      ]
    },
    {
      "name": "2c8579fa",
      "displayName": "Supplier Performance Metrics Overview",
      "queryLines": [
        "SELECT\r\n",
        "    supplier,\r\n",
        "    scan_success_rate\r\n",
        "FROM smip_v2.manufacturing.material_kpis;"
      ]
    },
    {
      "name": "be62db7a",
      "displayName": "Top Packaging Performance Insights",
      "queryLines": [
        "SELECT\r\n",
        "    product_name,\r\n",
        "    packages_completed\r\n",
        "FROM smip_v2.manufacturing.packaging_kpis\r\n",
        "ORDER BY packages_completed DESC;"
      ]
    },
    {
      "name": "dbe22fc0",
      "displayName": "Factory Shipment Readiness Performance Metrics",
      "queryLines": [
        "SELECT\r\n",
        "    shipment_readiness_rate\r\n",
        "FROM smip_v2.manufacturing.factory_dashboard;"
      ]
    }
  ],
